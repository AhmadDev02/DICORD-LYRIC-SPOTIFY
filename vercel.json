{
  "version": 2,
  "name": "discord-spotify-lyric-status",
  "builds": [
    { "src": "public/**/*", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/spotify/login", "dest": "/api/spotify/login.js" },
    { "src": "/api/spotify/callback", "dest": "/api/spotify/callback.js" },
    { "src": "/api/spotify/lyrics", "dest": "/api/spotify/lyrics.js" },
    { "src": "/api/sync", "dest": "/api/sync.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
